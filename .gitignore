# Byte-compiled / optimized / DLL files (Python Cache)
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Virtual Environments
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/

# Environment variables & Sensitive data
.env
*.env
*.pem
*.key
*.pcap
*.pcapng

# Application Exports & Generated Logs/Data
EndpointGuard/exports/*
!EndpointGuard/exports/.gitkeep
*.log
*.json_report
*.html_report

# OS Generated Files
.DS_Store
Thumbs.db

# IDEs & Code Editors
.vscode/
.idea/
*.swp
*.swo
*~

# Build & Distribution Artifacts
build/
dist/
*.egg-info/
.eggs/

# Testing & Coverage
.coverage
.pytest_cache/
htmlcov/

# Commit Guard (local security scanner) — safe to delete anytime
.commit_guard/
commit_guard_reports/
